# Torny CRM API — same base as the CRM stack, hosts /clubs/resolve + /public/clubs/:slug/site.
NUXT_TORNY_API_BASE_URL=https://byi59x19m4.execute-api.ap-southeast-2.amazonaws.com/Prod

# Shared secret with the CRM backend for the /api/revalidate HMAC signature.
# Rotate periodically. Generate with: openssl rand -hex 32
NUXT_REVALIDATE_SECRET=change-me

# Public site URL — used when building revalidate purge targets.
NUXT_PUBLIC_SITE_URL=https://sites.torny.club

# Torny member portal — used for the "Sign in with Torny" links on the
# tournament entry page. The portal handles auth and redirects visitors
# back to the ?next= URL after they sign in.
NUXT_PUBLIC_PORTAL_URL=https://torny.co

# Public API base for browser-side calls (/me, /public/*). MUST live on the
# same registrable domain as the site (`.torny.co`) for the cross-subdomain
# HttpOnly session cookie to flow on client fetches with credentials.
NUXT_PUBLIC_API_BASE_URL=https://api.torny.co
