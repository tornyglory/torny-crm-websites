{
  "name": "@torny/club-sites",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3001 nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler pages dev dist --compatibility-date=2024-10-01",
    "deploy": "nuxt build && wrangler pages deploy dist",
    "prepare": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "playwright test",
    "format": "prettier --write .",
    "clean": "rm -rf .nuxt .output .turbo dist"
  },
  "dependencies": {
    "@torny/api-client": "workspace:*",
    "@torny/content-blocks": "workspace:*",
    "@torny/design-tokens": "workspace:*",
    "nuxt": "^3.15.0",
    "vue": "^3.5.46",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.10.5",
    "jsdom": "^25",
    "typescript": "~5.9.3",
    "vitest": "^2",
    "vue-tsc": "^2.1.10",
    "wrangler": "^3.99.0"
  }
}
