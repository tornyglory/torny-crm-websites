# Torny API base URLs. See docs/backend-briefs/08-backend-response-m1-m3-m4-live.md.
# SAM = auth + mobile-shared endpoints (login, register, password reset).
# CRM = /me, claims, admin queue, and future CRM-only routes.
VITE_SAM_BASE_URL=https://ieg3lhlyy0.execute-api.ap-southeast-2.amazonaws.com/Prod
VITE_CRM_BASE_URL=https://byi59x19m4.execute-api.ap-southeast-2.amazonaws.com/Prod

# Club-sites preview URL. Set VITE_SITES_ORIGIN in dev to hit the local Nuxt
# app via the tenant middleware's ?host= override. Leave it empty in prod so
# links resolve to https://<slug>.<VITE_SITES_HOST_SUFFIX>/ instead.
VITE_SITES_ORIGIN=http://localhost:3001
VITE_SITES_HOST_SUFFIX=torny.club
