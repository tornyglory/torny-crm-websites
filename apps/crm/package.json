{
  "name": "@torny/crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@torny/api-client": "workspace:*",
    "@torny/content-blocks": "workspace:*",
    "@torny/design-tokens": "workspace:*",
    "pinia": "^2.3.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4",
    "@vue/tsconfig": "^0.7.0",
    "jsdom": "^25",
    "typescript": "~5.6.3",
    "vite": "^6.0.7",
    "vitest": "^2",
    "vue-tsc": "^2.1.10"
  }
}
