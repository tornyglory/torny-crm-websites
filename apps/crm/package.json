{
  "name": "@torny/crm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@sentry/vue": "^11.17.0",
    "@torny/api-client": "workspace:*",
    "@torny/content-blocks": "workspace:*",
    "@torny/design-tokens": "workspace:*",
    "dompurify": "^3.5.0",
    "pinia": "^2.3.0",
    "vue": "^3.5.46",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.1",
    "@playwright/test": "^1.65.1",
    "@sentry/vite-plugin": "^11.17.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.6",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^25",
    "typescript": "~5.9.3",
    "vite": "^6.4.6",
    "vitest": "^2",
    "vue-tsc": "^2.1.10"
  }
}
