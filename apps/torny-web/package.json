{
  "name": "@torny/torny-web",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "PORT=3002 nuxt dev",
    "build": "nuxt build",
    "preview": "wrangler pages dev .output/public --compatibility-date=2024-10-01",
    "deploy": "nuxt build && wrangler pages deploy .output/public",
    "typecheck": "nuxt typecheck",
    "lint": "echo ok",
    "clean": "rm -rf .nuxt .output .turbo dist"
  },
  "dependencies": {
    "@torny/api-client": "workspace:*",
    "@torny/design-tokens": "workspace:*",
    "nuxt": "^3.15.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "~5.6.3",
    "vue-tsc": "^2.1.10",
    "wrangler": "^3.99.0"
  }
}
