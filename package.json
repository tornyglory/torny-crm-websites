{
  "name": "torny",
  "private": true,
  "version": "0.0.0",
  "description": "Torny monorepo — CRM (Vue), public club sites (Nuxt), Capacitor player apps, shared packages",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:crm": "pnpm --filter @torny/crm dev",
    "dev:sites": "pnpm --filter @torny/club-sites dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "~5.6.3"
  }
}
