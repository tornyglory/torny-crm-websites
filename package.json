{
  "name": "torny",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "description": "Torny monorepo — CRM (Vue), public club sites (Nuxt), Capacitor player apps, shared packages",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:crm": "pnpm --filter @torny/crm dev",
    "dev:sites": "pnpm --filter @torny/club-sites dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "eslint": "^9",
    "eslint-plugin-vue": "^10.12.0",
    "prettier": "^3.9.10",
    "turbo": "^2.3.3",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^3.99.0"
  }
}
