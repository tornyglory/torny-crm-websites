    "@tiptap/vue-3": "^3.35.0",
    "@torny/api-client": "workspace:*",
    "@torny/design-tokens": "workspace:*",
    "isomorphic-dompurify": "^4.8.0"
  },
  "devDependencies": {
    "jsdom": "^25",
    "typescript": "~5.9.3",
    "vitest": "^2",
    "vue": "^3.5.46",
    "vue-tsc": "^2.1.10"
